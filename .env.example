# ABUTAS.COM — Environment Configuration Example
#
# Salin file ini menjadi .env.local untuk development lokal:
#   cp .env.example .env.local
#
# PERINGATAN KEAMANAN:
# - JANGAN pernah memasukkan secret/API keys production ke dalam repository Git.
# - File .env.local sudah masuk ke .gitignore dan tidak boleh di-commit.
# - Seluruh data operasional di bawah ini wajib diverifikasi sebelum digunakan.

# ==============================================================================
# 1. BASE SITE CONFIGURATION
# ==============================================================================
# URL target kanonikal website publik
NEXT_PUBLIC_SITE_URL=https://abutas.com

# ==============================================================================
# 2. SANITY CMS CONFIGURATION (STEP 03A)
# ==============================================================================
# Disediakan oleh pemilik dari dashboard Sanity (https://www.sanity.io/manage)
# Biarkan kosong jika CMS belum dibuat; build Next.js tetap berjalan aman tanpa konten fiktif.

# ID Proyek Sanity (contoh: a1b2c3d4)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset yang digunakan (default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Versi API Sanity bertanggal ISO (default: 2026-11-01)
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Token pembaca API Sanity (HANYA digunakan pada Node.js/CI build time jika dataset privat)
# JANGAN pernah menggunakan prefix NEXT_PUBLIC_ untuk token rahasia ini!
SANITY_API_READ_TOKEN=

# ==============================================================================
# 3. WHATSAPP & CONTACT INTEGRATION (STEP 05 — TERTUNDA VERIFIKASI)
# ==============================================================================
# Nomor WhatsApp resmi dalam format internasional tanpa tanda '+' (contoh: 6281234567890)
# Status: WAJIB TERVERIFIKASI oleh pemilik di docs/business-facts.md sebelum diaktifkan.
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# ==============================================================================
# 4. RFQ PERSISTENCE & EMAIL NOTIFICATION (STEP 05)
# ==============================================================================
# Provider penyimpanan/pengiriman lead form RFQ tanpa VPS (misal: webhook/cPanel mail forwarder)
# RFQ_PERSISTENCE_PROVIDER=
